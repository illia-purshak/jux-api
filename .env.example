# Copy to `.env` and fill in: cp .env.example .env

# Prefix for docker compose containers/volumes/network — the project name
COMPOSE_PROJECT_NAME=jux_api

# App
# `development` enables Swagger UI (/docs) by default
NODE_ENV=development
PORT=9001
CORS_ORIGIN=http://localhost:5173
# Swagger UI at /docs: overrides the NODE_ENV default (true|false)
# SWAGGER_ENABLED=true

# local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=jux_api
# Optional pg pool tuning (ignored if empty / not a positive integer)
POSTGRES_POOL_MAX=10
POSTGRES_POOL_CONNECTION_TIMEOUT_MS=5000

# JWT
# Generate a secret: openssl rand -base64 48
JWT_SECRET=
# Access token lifetime, with a unit: 15m, 1h, 7d (a bare number = milliseconds!)
JWT_EXPIRATION_TIME=15m

# pgAdmin (docker compose --profile tools up -d)
PGADMIN_PORT=8083
PGADMIN_LOGIN_EMAIL=admin@example.com
PGADMIN_LOGIN_PASSWORD=admin
