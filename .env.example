# Copy to `.env` and fill in: cp .env.example .env

# Prefix for docker compose containers/volumes/network — the project name
COMPOSE_PROJECT_NAME=template_api

# App
# `development` enables Swagger UI (/docs) by default
NODE_ENV=development
PORT=9001
CORS_ORIGIN=http://localhost:5173
# Swagger UI at /docs: overrides the NODE_ENV default (true|false)
# SWAGGER_ENABLED=true

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=template_api

# pgAdmin (docker compose --profile tools up -d)
PGADMIN_PORT=8083
PGADMIN_LOGIN_EMAIL=admin@example.com
PGADMIN_LOGIN_PASSWORD=admin
